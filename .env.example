# Copy to .env and adjust. Everything here is for LOCAL DEVELOPMENT ONLY.
# Docker Compose overrides the database/Redis URLs for its containers.

# Port 5433 / 6380 are where docker-compose publishes Postgres / Redis on the host.
DATABASE_URL=postgresql+psycopg://eve:eve@localhost:5433/eve
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1

# Used by docker-compose to initialise the containers.
POSTGRES_USER=eve
POSTGRES_PASSWORD=eve
POSTGRES_DB=eve
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Generate real values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Shared secret between us and the (simulated) payment provider, used to sign webhooks.
WEBHOOK_SECRET=change-me-webhook-signing-secret
WEBHOOK_TOLERANCE_SECONDS=300

BOOKING_PAYMENT_WINDOW_MINUTES=30
CATALOGUE_CACHE_TTL_SECONDS=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITES_PER_MINUTE=30

LOG_LEVEL=INFO
# json for containers/log shippers, text for reading in a terminal.
LOG_FORMAT=text

# Set true to run Celery tasks inline (no worker needed); handy for a quick local run.
CELERY_TASK_ALWAYS_EAGER=false

# Only read by `python -m app.seed` to create a local admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-dev-password
